# Local application settings
APP_ENV=development
APP_NAME=ResolveAI API
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Phase 5 admin authentication settings
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRY_MINUTES=

# Phase 2 database settings
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres?sslmode=require
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_RECYCLE_SECONDS=1800

# Phase 3 embedding and retrieval settings
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
RAG_CHUNK_TOKEN_LIMIT=1800
RAG_CHUNK_OVERLAP_TOKENS=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=
